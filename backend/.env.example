MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/familystore
# OBLIGATOIRE — sans elle l'application refuse de démarrer.
# Générer une valeur : openssl rand -hex 32
JWT_SECRET=your_secret_here
# Durée du jeton (renouvellement glissant via /api/auth/refresh)
JWT_EXPIRES_IN=24h
PORT=3000
# Nombre de proxys devant l'application (Netlify + Render = 2).
# Sert à retrouver l'IP réelle du client pour la limitation de débit.
TRUST_PROXY_HOPS=2
NODE_ENV=production
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_ALERT_TO=patron@familystore.cm
# Nom d'application dans les logs de démarrage et le healthcheck (facultatif).
# Le nom affiché aux utilisateurs (tickets, PDF, e-mails) vient des Paramètres
# magasin, pas d'ici.
APP_NAME=Family Store POS
# Mode de cloisonnement : single (une base = un magasin, défaut) | multi
TENANT_MODE=single
# Origines autorisées en CORS (sites qui appellent ce backend en direct).
# Défaut : les deux sites Netlify connus. Séparées par des virgules.
CORS_ORIGINS=https://familystore-pos.netlify.app,https://radiance-pos.netlify.app
