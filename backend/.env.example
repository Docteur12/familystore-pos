MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/familystore
# OBLIGATOIRE — sans elle l'application refuse de démarrer.
# Générer une valeur : openssl rand -hex 32
JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=7d
PORT=3000
# Nombre de proxys devant l'application (Netlify + Render = 2).
# Sert à retrouver l'IP réelle du client pour la limitation de débit.
TRUST_PROXY_HOPS=2
NODE_ENV=production
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_ALERT_TO=patron@familystore.cm
