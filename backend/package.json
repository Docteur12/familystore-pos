{
  "name": "familystore-pos-backend",
  "version": "1.0.0",
  "description": "Family Store POS - Backend NestJS",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register seeds/seed.ts",
    "migrate:tenant": "ts-node -r tsconfig-paths/register scripts/migrate-add-tenant.ts",
    "migrate:tenant:rollback": "ts-node -r tsconfig-paths/register scripts/migrate-rollback.ts",
    "migrate:settings": "ts-node -r tsconfig-paths/register scripts/migrate-settings-identite.ts",
    "migrate:pin": "ts-node -r tsconfig-paths/register scripts/migrate-pin-caisses.ts",
    "verifier:tenancy": "ts-node -r tsconfig-paths/register scripts/verifier-tenancy.ts",
    "migrate:pin:rollback": "ts-node -r tsconfig-paths/register scripts/migrate-pin-rollback.ts",
    "migrate:settings:rollback": "ts-node -r tsconfig-paths/register scripts/migrate-settings-rollback.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed:demo": "ts-node -r tsconfig-paths/register scripts/seed-demo.ts",
    "demo:mongo": "node scripts/demo-mongo.js",
    "demo:api": "node scripts/demo-api.js",
    "verifier:lot-e": "ts-node -r tsconfig-paths/register scripts/verifier-lot-e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.2",
    "mongoose": "^7.5.0",
    "nestjs-cls": "^6.2.1",
    "nodemailer": "^6.9.7",
    "puppeteer-core": "^25.2.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
